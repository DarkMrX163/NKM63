rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll(['playerName', 'score', 'level', 'accuracy', 'correctAnswers', 'totalQuestions', 'createdAt'])
        && data.keys().hasOnly(['playerName', 'avatar', 'score', 'level', 'accuracy', 'correctAnswers', 'totalQuestions', 'createdAt'])
        && data.playerName is string && data.playerName.size() >= 1 && data.playerName.size() <= 50
        && (data.avatar == null || (data.avatar is string && data.avatar.size() <= 50))
        && data.score is int && data.score >= 0 && data.score <= 100000
        && data.level in ['easy', 'medium', 'hard', 'mixed']
        && data.accuracy is int && data.accuracy >= 0 && data.accuracy <= 100
        && data.correctAnswers is int && data.correctAnswers >= 0
        && data.totalQuestions is int && data.totalQuestions >= 1
        && data.createdAt is string && data.createdAt.size() <= 50;
    }

    // Leaderboard collection access
    match /leaderboard/{entryId} {
      allow read: if true;
      allow create: if isValidId(entryId) && isValidLeaderboardEntry(incoming());
      allow update, delete: if false; // Scores are immutable
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
